  "glossary": [
    {
      "term": "数独",
      "def": "在 9×9 盘面上填 1–9，使每行、每列、每宫各含 1–9 一次。",
      "chapterId": "ch01"
    },
    {
      "term": "格",
      "def": "盘面上的一个位置，共 81 个。",
      "chapterId": "ch01"
    },
    {
      "term": "行",
      "def": "横向 9 格，共 9 行。",
      "chapterId": "ch01"
    },
    {
      "term": "列",
      "def": "纵向 9 格，共 9 列。",
      "chapterId": "ch01"
    },
    {
      "term": "宫",
      "def": "粗线围出的 3×3 区域，共 9 个。",
      "chapterId": "ch01"
    },
    {
      "term": "单元",
      "def": "行、列、宫的统称；一个单元有 9 格，必须含 1–9 各一次。",
      "chapterId": "ch01"
    },
    {
      "term": "坐标",
      "def": "R4C5 表示第 4 行第 5 列；行在前，列在后。",
      "chapterId": "ch01"
    },
    {
      "term": "提示数",
      "def": "题目一开始给出的数字，也叫线索（clue）。",
      "chapterId": "ch02"
    },
    {
      "term": "终盘",
      "def": "填满且合法的完整盘面。",
      "chapterId": "ch02"
    },
    {
      "term": "合法",
      "def": "没有同一行、同一列或同一宫重复的数字。",
      "chapterId": "ch01"
    },
    {
      "term": "唯一解",
      "def": "一盘题只有一个合法终盘；多解则是两个及以上。",
      "chapterId": "ch02"
    },
    {
      "term": "候选数",
      "def": "某个空格当前还可能填的数字，记作铅笔标记。",
      "chapterId": "ch03"
    },
    {
      "term": "铅笔标记",
      "def": "在格子里用小字写候选数，通常按 1–9 固定位置排列。",
      "chapterId": "ch03"
    },
    {
      "term": "排除",
      "def": "从某格候选里划掉一个数字，不是填数。",
      "chapterId": "ch03"
    },
    {
      "term": "落子",
      "def": "把某个候选确定为该格的数字。",
      "chapterId": "ch04"
    },
    {
      "term": "唯一余数",
      "def": "某格只剩一个候选，直接填它（Naked Single）。",
      "chapterId": "ch04"
    },
    {
      "term": "隐性唯一",
      "def": "某单元里某数字只剩一个位置，填它（Hidden Single）。",
      "chapterId": "ch05"
    },
    {
      "term": "区块",
      "def": "一个宫里某数字的候选集中在一条线（行或列）上。",
      "chapterId": "ch06"
    },
    {
      "term": "指向",
      "def": "宫 → 线：宫内的候选锁在一条线上，删这条线在宫外的候选。",
      "chapterId": "ch06"
    },
    {
      "term": "声明",
      "def": "线 → 宫：线上的候选锁在一个宫内，删这个宫在线外的候选。",
      "chapterId": "ch06"
    },
    {
      "term": "显性数对",
      "def": "同一单元两格的候选并集恰好是 {a,b}，其他格删 a、b。",
      "chapterId": "ch07"
    },
    {
      "term": "隐性数对",
      "def": "同一单元两个数字只出现在两格，这两格只保留这两个数字。",
      "chapterId": "ch07"
    },
    {
      "term": "三数组 / 四数组",
      "def": "显性或隐性数组在 n=3、4 时的形式。",
      "chapterId": "ch07"
    },
    {
      "term": "共轭对",
      "def": "某单元里同一数字只剩两个位置；两者必有一真。",
      "chapterId": "ch12"
    },
    {
      "term": "X-Wing",
      "def": "两行某数字都只剩相同两列，形成 2×2 矩形，删这两列其他行的该数字。",
      "chapterId": "ch08"
    },
    {
      "term": "Swordfish",
      "def": "X-Wing 的三线版本：3 行 3 列。",
      "chapterId": "ch09"
    },
    {
      "term": "Jellyfish",
      "def": "X-Wing 的四线版本：4 行 4 列。",
      "chapterId": "ch09"
    },
    {
      "term": "XY-Wing",
      "def": "双值枢纽 {x,y} 与两翼 {x,z}、{y,z}，删两翼共同可见格的 z。",
      "chapterId": "ch11"
    },
    {
      "term": "XYZ-Wing",
      "def": "三值枢纽 {x,y,z} 与两翼 {x,z}、{y,z}，删三格共同可见格的 z。",
      "chapterId": "ch11"
    },
    {
      "term": "唯一矩形",
      "def": "利用唯一解假设排除矩形第四格的 a、b 的技巧。",
      "chapterId": "ch10"
    },
    {
      "term": "死锁模式",
      "def": "四格 {a,b} 可互换产生第二解的结构，唯一矩形要避免它。",
      "chapterId": "ch10"
    },
    {
      "term": "强链",
      "def": "两个候选至少一个为真（¬A→B）。",
      "chapterId": "ch12"
    },
    {
      "term": "弱链",
      "def": "两个候选至多一个为真（A→¬B）。",
      "chapterId": "ch12"
    },
    {
      "term": "染色",
      "def": "把同一数字的共轭对交替染成两色，用颜色冲突排除候选。",
      "chapterId": "ch12"
    },
    {
      "term": "AIC",
      "def": "交替推理链：强链、弱链交替，两端为强链时至少一端为真。",
      "chapterId": "ch12"
    },
    {
      "term": "回溯",
      "def": "选一个候选试填，失败后退回上一步换下一个候选。",
      "chapterId": "ch14"
    },
    {
      "term": "MRV",
      "def": "Minimum Remaining Values：优先选候选最少的格子试填。",
      "chapterId": "ch14"
    },
    {
      "term": "精确覆盖",
      "def": "用一组行精确覆盖所有列一次的问题模型。",
      "chapterId": "ch14"
    },
    {
      "term": "DLX",
      "def": "Dancing Links，Knuth 提出的十字链表，用来高效实现精确覆盖。",
      "chapterId": "ch14"
    },
    {
      "term": "挖洞法",
      "def": "从完整终盘逐个去掉提示数，每次用求解器确认仍然唯一解。",
      "chapterId": "ch15"
    },
    {
      "term": "难度层级",
      "def": "解出题目所需的最低技巧层级，不等于提示数。",
      "chapterId": "ch15"
    },
    {
      "term": "拉丁方",
      "def": "每行每列各含 1–n 一次的 n×n 方阵；数独是带宫约束的 9 阶拉丁方。",
      "chapterId": "ch02"
    },
    {
      "term": "对称挖洞",
      "def": "按中心对称成对去掉提示数，盘面更整齐，但会限制能挖到的难度。",
      "chapterId": "ch15"
    }
  ],
  "quizzes": [
    {
      "id": "q01",
      "chapterId": "ch01",
      "type": "single",
      "question": "标准数独里的“宫”是什么形状？",
      "options": [
        "3×3 的九格方块",
        "3×9 的长条",
        "9×3 的长条",
        "1×9 的一行"
      ],
      "answer": 0,
      "explain": "宫是粗线围出的 3×3 区域，共 9 个；三宫横排成一带，三宫竖排成一栈。",
      "relatedConceptId": "c01",
      "source": {
        "file": "知枢学习系统生成",
        "page": 0
      }
    },
    {
      "id": "q02",
      "chapterId": "ch01",
      "type": "single",
      "question": "R4C5 属于第几宫？",
      "options": [
        "B2",
        "B4",
        "B5",
        "B8"
      ],
      "answer": 2,
      "explain": "第 4–6 行属于第二带，第 4–6 列属于第二栈，交叉处是第 5 宫（B5）。",
      "relatedConceptId": "c01",
      "source": {
        "file": "知枢学习系统生成",
        "page": 0
      }
    },
    {
      "id": "q03",
      "chapterId": "ch01",
      "type": "single",
      "question": "下面哪一条是数独的合法条件？",
      "options": [
        "每行、每列、每宫都含 1–9 各一次",
        "每行数字之和等于 45",
        "两条对角线的数字之和相等",
        "81 格全部填满"
      ],
      "answer": 0,
      "explain": "和等于 45 是“每行含 1–9”的推论，不是条件本身；对角线不是标准数独的约束；填满不等于合法。",
      "relatedConceptId": "c01",
      "source": {
        "file": "知枢学习系统生成",
        "page": 0
      }
    },
    {
      "id": "q04",
      "chapterId": "ch02",
      "type": "single",
      "question": "数独比 9 阶拉丁方多出来的约束是什么？",
      "options": [
        "两条对角线",
        "9 个 3×3 宫各含 1–9",
        "每行数字之和为 45",
        "必须对称"
      ],
      "answer": 1,
      "explain": "拉丁方只管每行每列 1–9 各一次；数独在此之上要求 9 个 3×3 宫也各含 1–9 一次。",
      "relatedConceptId": "c02",
      "source": {
        "file": "知枢学习系统生成",
        "page": 0
      }
    },
    {
      "id": "q05",
      "chapterId": "ch02",
      "type": "single",
      "question": "保证唯一解最少需要几个提示数？",
      "options": [
        "16",
        "17",
        "18",
        "21"
      ],
      "answer": 1,
      "explain": "McGuire、Tugemann、Civario 在 2012 年穷举证明 16 个提示不可能唯一解，17 个可以。",
      "relatedConceptId": "c02",
      "source": {
        "file": "知枢学习系统生成",
        "page": 0
      }
    },
    {
      "id": "q06",
      "chapterId": "ch02",
      "type": "single",
      "question": "6,670,903,752,021,072,936,960 这个数是什么？",
      "options": [
        "合法终盘总数",
        "本质不同的终盘数",
        "9 阶拉丁方的数量",
        "17 提示题的数量"
      ],
      "answer": 0,
      "explain": "这是 Felgenhauer 与 Jarvis 在 2005 年算出的合法 9×9 终盘总数，约 6.67×10²¹。本质不同的终盘数是 5,472,730,538。",
